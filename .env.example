# ============================================================
#  Variables de entorno — copia este archivo a `.env` y rellena
# ============================================================

# --- Proveedor LLM (endpoint compatible con OpenAI) ---
# Por defecto usamos Groq (capa gratuita, rápido).
# Consigue tu key en: https://console.groq.com/keys
LLM_API_KEY=tu_api_key_aqui
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Alternativas (descomenta y ajusta si cambias de proveedor) ---
# NVIDIA NIM:
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_MODEL=meta/llama-3.1-70b-instruct
# Ollama (local, no requiere key real):
#   LLM_API_KEY=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.1
